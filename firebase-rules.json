{
  "rules": {
    "office_codes": {
      ".read": false,
      ".write": false
    },

    "office_sessions": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid && ((!newData.exists() && !newData.child('code').exists()) || (newData.child('code').isString() && newData.child('code').val().length > 0 && newData.child('code').val().length <= 64 && root.child('office_codes').child(newData.child('code').val()).exists()))",
        "code": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" },
        "ts": { ".validate": "newData.val() == null || newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "office": {
      ".read": "auth != null && root.child('office_sessions').child(auth.uid).child('code').isString() && root.child('office_codes').child(root.child('office_sessions').child(auth.uid).child('code').val()).exists()",
      ".write": "auth != null && root.child('office_sessions').child(auth.uid).child('code').isString() && root.child('office_codes').child(root.child('office_sessions').child(auth.uid).child('code').val()).exists()",

      "agents": {
        "$agentId": {
          "name":     { ".validate": "newData.isString() && newData.val().length <= 40" },
          "initial":  { ".validate": "newData.isString() && newData.val().length <= 4" },
          "status":   { ".validate": "newData.isString() && newData.val().length <= 120" },
          "email":    { ".validate": "newData.isString() && newData.val().length <= 120" },
          "location": { ".validate": "newData.isString() && newData.val().matches(/^(meeting|workspace|lounge|away)$/)" },
          "desk":     { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 12)" }
        }
      },

      "chat": {
        "$msgId": {
          "text": { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 40" }
        }
      },

      "tasks": {
        "$taskId": {
          "title":  { ".validate": "newData.isString() && newData.val().length <= 200" },
          "status": { ".validate": "newData.val() == null || newData.val().matches(/^(todo|doing|done)$/)" }
        }
      },

      "notes":     { "$noteId":     { "title": { ".validate": "newData.isString() && newData.val().length <= 200" } } },
      "agenda":    { "$agendaId":   { "text":  { ".validate": "newData.isString() && newData.val().length <= 300" } } },
      "decisions": { "$decisionId": { "text":  { ".validate": "newData.isString() && newData.val().length <= 400" } } }
    }
  }
}
